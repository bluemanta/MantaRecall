# ============ 必填 ============
# 评测平台发给你的 API Key（Add/Search 鉴权用）。不要提交到 git。
MEMORY_API_KEY=change-me-to-a-long-random-string

# pgvector 连接串（docker-compose 内默认值一般不用改）
DATABASE_URL=postgresql://aml:amlpass@db:5432/aml

# ============ 学术榜模型（硬约束，不要改模型名） ============
# Embedding：必须是 text-embedding-v4（1024 维）
EMBEDDING_PROVIDER=openai_compatible   # openai_compatible | stub（stub 仅本地无成本联调，绝不能用于正式评测）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
EMBEDDING_SEND_DIMENSIONS=true        # 某些兼容网关不支持 dimensions 参数时改为 false
EMBEDDING_BATCH_SIZE=32

# LLM：学术榜 LLM 相关组件必须用 gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-api-key
LLM_MODEL=gpt-4o-mini

# ============ 服务 ============
CONFIG_PATH=/app/config.yaml          # 本地跑时改为 ./config.yaml
WORKERS=2                             # uvicorn worker 数（docker-compose 里用）
LOG_LEVEL=info

# ============ Reranker（学术榜不限，可选） ============
RERANKER_MODEL=none                   # none=关闭；cross-encoder/ms-marco-MiniLM-L6-v2 或本地路径=开启
RERANK_TOP_N=50                       # RRF 融合后取前 N 候选做 cross-encoder 精排
RERANK_THREADS=1                      # cross-encoder 推理线程数；高并发下设 1 避免抢核拖慢 p95
